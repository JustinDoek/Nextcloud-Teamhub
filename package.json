{
  "name": "teamhub",
  "version": "4.20.0",
  "description": "Team collaboration hub for Nextcloud",
  "scripts": {
    "clean:chunks": "node -e \"require('fs').rmSync('js/chunks',{recursive:true,force:true})\"",
    "prebuild": "npm run clean:chunks",
    "predev": "npm run clean:chunks",
    "dev": "vite build --mode development && node scripts/generate-integrity.js",
    "build": "vite build && node scripts/generate-integrity.js",
    "watch": "vite build --mode development --watch",
    "integrity": "node scripts/generate-integrity.js",
    "check:l10n": "node scripts/check-l10n.js",
    "check:di": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-di-cycles.js",
    "check:dates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-localdate.js",
    "check:markdown-list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-markdown-list.js",
    "check:migrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-migrations.js",
    "check:classes": "node scripts/check-classes.js",
    "check:vue-methods": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-vue-methods.js",
    "check:dashes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-dashes.js",
    "test:js": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/js/register.mjs --test tests/js/*.test.mjs",
    "test:php": "node scripts/test-php.js",
    "test": "npm run test:js && npm run test:php",
    "scim:rig": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/scim-test-rig.js",
    "deploy:aio": "npm run build && node scripts/deploy-to-aio.js",
    "publish:release": "npm run build && node scripts/publish-to-release.js",
    "check:nextcloud-basics": "node scripts/check-nextcloud-basics.js",
    "check:release": "npm run check:l10n && npm run check:nextcloud-basics && npm run check:di && npm run check:dates && npm run check:migrations && npm run check:vue-methods && npm run check:dashes && npm run check:markdown-list && npm run test:js && npm run check:ui-native",
    "lint:js": "node scripts/run-eslint-check.js",
    "lint:php": "composer run cs:check",
    "analyse:php": "composer run analyse:php",
    "check:ui-native": "node scripts/check-nextcloud-ui.js",
    "check:standards": "npm run lint:js && npm run lint:php && npm run analyse:php"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@nextcloud/auth": "^2.4.0",
    "@nextcloud/axios": "^2.5.1",
    "@nextcloud/dialogs": "^7.0.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/logger": "^3.0.3",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.0.0",
    "dompurify": "^3.4.2",
    "grid-layout-plus": "^1.1.1",
    "linkifyjs": "^4.1.3",
    "marked": "^14.1.3",
    "vue": "^3.5.0",
    "vue-material-design-icons": "^5.3.0",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/vite-config": "^2.0.0",
    "eslint": "^10.13.0",
    "sass": "^1.83.0"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true
  }
}
