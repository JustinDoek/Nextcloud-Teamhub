    <!-- Child order is fixed by the xsd's <xs:sequence>, not free: … screenshot,
         dependencies, background-jobs, repair-steps, commands, settings,
         activity, dashboard, fulltextsearch, navigations, … Inside
         <dependencies> it is php before nextcloud. Both were wrong here until
         v4.11.1; Nextcloud itself reads this file with XPath and never noticed,
         but the App Store validates against the schema on upload. -->
    <dependencies>
        <php min-version="8.1" max-version="8.5"/>
        <nextcloud min-version="33" max-version="35"/>
    </dependencies>

    <background-jobs>
        <job>OCA\TeamHub\BackgroundJob\AuditMirrorJob</job>
        <job>OCA\TeamHub\BackgroundJob\PendingDeletionJob</job>
        <job>OCA\TeamHub\BackgroundJob\ResourceDiscoveryJob</job>
        <job>OCA\TeamHub\BackgroundJob\PresenceMaterialisationJob</job>
        <job>OCA\TeamHub\BackgroundJob\TalkMembershipReconcileJob</job>
        <job>OCA\TeamHub\BackgroundJob\GroupMirrorReconcileJob</job>
        <job>OCA\TeamHub\BackgroundJob\MilestoneAutoPostJob</job>
        <job>OCA\TeamHub\BackgroundJob\LicenseExpiryNotificationJob</job>
        <job>OCA\TeamHub\BackgroundJob\TelemetryReportJob</job>
        <job>OCA\TeamHub\BackgroundJob\TeamImportJob</job>
        <job>OCA\TeamHub\BackgroundJob\ProvisioningJob</job>
        <job>OCA\TeamHub\BackgroundJob\TeamSpaceReconcileJob</job>
        <job>OCA\TeamHub\BackgroundJob\ExpireWorkflowSharesJob</job>
        <job>OCA\TeamHub\BackgroundJob\TeamAdoptionSweepJob</job>
    </background-jobs>

    <!-- v4.11.1 — <post-migration> precedes <install> because the xsd's
         sequence says so (pre-migration, post-migration, live-migration,
         install, uninstall), not for any runtime reason. Nextcloud resolves
         these by name. -->
    <repair-steps>
        <post-migration>
            <step>OCA\TeamHub\Migration\RepairSteps\SeedPresenceTypes</step>
            <step>OCA\TeamHub\Migration\RepairSteps\SeedTemplatesAndProfiles</step>
            <step>OCA\TeamHub\Migration\RepairSteps\BackfillDeckStackOrder</step>
            <step>OCA\TeamHub\Migration\RepairSteps\ScheduleTeamSpaceReconcile</step>
            <step>OCA\TeamHub\Migration\RepairSteps\DropRetiredMyWorkSettings</step>
            <step>OCA\TeamHub\Migration\RepairSteps\DropRetiredWorkflowSettings</step>
            <step>OCA\TeamHub\Migration\RepairSteps\DropOrphanedServiceTeams</step>
            <!-- v4.10.29 — in this order: the holder of the Nextcloud services
                 must offer the quota request before an open one looks for its queue. -->
            <step>OCA\TeamHub\Migration\RepairSteps\CompleteNextcloudServicesBundle</step>
            <step>OCA\TeamHub\Migration\RepairSteps\ImportLedgerQuotaRequests</step>
        </post-migration>
        <!-- A fresh install runs the migrations schema-only (no pre/post
             steps) and skips <post-migration>; the seeds must be listed under
             <install> as well, or a new instance has no templates, profiles
             or presence types (v4.10.3). -->
        <install>
            <step>OCA\TeamHub\Migration\RepairSteps\SeedPresenceTypes</step>
            <step>OCA\TeamHub\Migration\RepairSteps\SeedTemplatesAndProfiles</step>
        </install>
    </repair-steps>

    <settings>
        <admin>OCA\TeamHub\Settings\AdminSettings</admin>
        <admin-section>OCA\TeamHub\Settings\AdminSection</admin-section>
        <personal>OCA\TeamHub\Settings\PersonalSettings</personal>
        <personal-section>OCA\TeamHub\Settings\PersonalSection</personal-section>
    </settings>

